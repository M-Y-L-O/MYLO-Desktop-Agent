SERVER_IP="127.0.0.1"
SERVER_PORT="8080"
# Comma-separated browser origins allowed to call this agent (CORS).
# Needed when the web UI is not on http://localhost:3000 (e.g. Vercel).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://mylo-web-deployment.vercel.app,https://mylo.website,https://www.mylo.website
# Set ENABLE_AGENT_DOCS=1 only for local debugging of Swagger UI
# ENABLE_AGENT_DOCS=0
